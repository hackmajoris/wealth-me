# Copy to .env and adjust. Docker Compose reads .env automatically.

# Host directory holding wealth.db (mounted at /data in the container).
# macOS suggestion: ${HOME}/Library/Application Support/WealthMe
DATA_DIR=./data

# Host port the app is published on.
HOST_PORT=8080

# SQLCipher encryption key. Leave empty to disable encryption.
# Keep it in a password manager: a lost key means an unreadable database.
DB_KEY=
